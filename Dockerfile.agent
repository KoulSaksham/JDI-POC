# Agent needs the jdk.jdi module at RUNTIME (it's JDK-only, not in a
# JRE), so unlike the target, we ship the full JDK image, not just JRE.
FROM eclipse-temurin:21-jdk
WORKDIR /app
COPY agent/ agent/
RUN mkdir -p classes/agent out \
    && javac -d classes/agent agent/com/example/agent/*.java

# Where to find the target's JDWP port; override at `docker run` time
# with -e TARGET_HOST=... -e TARGET_PORT=... if not using compose.
ENV TARGET_HOST=target
ENV TARGET_PORT=5005
ENV AGENT_OUTPUT_FILE=/app/out/captured_state.json

ENTRYPOINT ["sh", "-c", "java -cp classes/agent com.example.agent.InstrumentationAgent \"$TARGET_HOST\" \"$TARGET_PORT\" \
    com.example.target.AdditionEngine#add \
    com.example.target.MultiplicationEngine#multiply \
    com.example.target.MathService#calculate \
    com.example.target.RouteHandler#handle"]
